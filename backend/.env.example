# Copy this file to .env and fill in your values

# Required: Get your key from https://aistudio.google.com
GEMINI_API_KEY= 

# Database — SQLite by default (no setup needed)
# Swap to postgres:// when ready for production
DATABASE_URL=sqlite:///./feed_indexer.db

# How often to fetch new articles (minutes)
FETCH_INTERVAL_MINUTES=30

# How many hours back to look when deduplicating
DEDUP_WINDOW_HOURS=48

# Similarity threshold for clustering articles into the same event (0.0 - 1.0)
SIMILARITY_THRESHOLD=0.35
